{
  "expo": {
    "name": "Scratch Kitchen Staff",
    "slug": "scratch-kitchen-staff",
    "scheme": "scratchkitchenstaff",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scratchkitchen.staff"
    },
    "android": {
      "package": "com.scratchkitchen.staff",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Scratch Kitchen Staff Hub",
      "shortName": "SK Staff",
      "description": "Orders, items needed, inventory, customers and reports for the Scratch Kitchen team.",
      "themeColor": "#D4202A",
      "backgroundColor": "#FAF6F3",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cc526b05-ec97-4c1a-805d-38aad56d45be"
      }
    },
    "owner": "r3dxx"
  }
}
